{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flexforge.dev/schema/config/v0.json",
  "title": "FlexForge App Config Bundle",
  "description": "Declarative definition of a FlexForge application. The engine interprets this at runtime; no source code is generated.",
  "type": "object",
  "required": ["appId", "entities"],
  "properties": {
    "appId": {
      "type": "string",
      "minLength": 1,
      "description": "Stable application identifier."
    },
    "configVersion": {
      "type": "string",
      "description": "Semantic version of this bundle."
    },
    "engineVersion": {
      "type": "string",
      "description": "Engine version this bundle is pinned to."
    },
    "database": {
      "type": "object",
      "properties": {
        "engine": {
          "type": "string",
          "description": "h2 | postgres | mysql (may be a ${ENV} placeholder)."
        },
        "url": { "type": "string" },
        "username": { "type": "string" },
        "password": { "type": "string" },
        "pool": {
          "type": "object",
          "properties": {
            "maxSize": { "type": "integer", "minimum": 1 },
            "minIdle": { "type": "integer", "minimum": 0 },
            "maxLifetimeMs": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "fields"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "table": { "type": "string" },
          "idStrategy": { "type": "string", "enum": ["IDENTITY", "SEQUENCE"] },
          "fields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["name", "type"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "type": {
                  "type": "string",
                  "enum": ["STRING", "TEXT", "INT", "LONG", "DOUBLE", "DECIMAL", "BOOLEAN", "DATE", "TIMESTAMP", "JSON", "REFERENCE", "FILE"]
                },
                "pk": { "type": "boolean" },
                "unique": { "type": "boolean" },
                "nullable": { "type": "boolean" },
                "length": { "type": "integer", "minimum": 1 },
                "column": { "type": "string" },
                "minLength": { "type": "integer", "minimum": 0 },
                "maxLength": { "type": "integer", "minimum": 0 },
                "min": { "type": "number" },
                "max": { "type": "number" },
                "pattern": { "type": "string" },
                "email": { "type": "boolean" },
                "encrypted": { "type": "boolean" },
                "uiVisible": { "type": "boolean" },
                "references": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "api": {
      "type": "object",
      "properties": {
        "rest": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "basePath": { "type": "string" }
          }
        },
        "graphql": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "path": { "type": "string" }
          }
        }
      }
    },
    "migrationPolicy": {
      "type": "object",
      "properties": {
        "additive": { "type": "string" },
        "destructive": { "type": "string" },
        "pattern": { "type": "string" },
        "backupBeforeApply": { "type": "boolean" }
      }
    },
    "security": {
      "type": "object",
      "description": "Config-driven JWT auth. When enabled is false the app is open.",
      "properties": {
        "enabled": { "type": "boolean" },
        "jwtSecret": { "type": "string" },
        "tokenTtlMinutes": { "type": "integer", "minimum": 1 },
        "users": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["username", "password"],
            "properties": {
              "username": { "type": "string", "minLength": 1 },
              "password": { "type": "string", "minLength": 1 },
              "roles": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "rules": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "read": { "type": "array", "items": { "type": "string" } },
              "write": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    }
  }
}
